{
  "name": "dsh-plugin-dbgraph-service",
  "version": "0.1.0",
  "description": "Service Definition for the DeepSeek Harness database-graph capability seam (ctx.dbgraph): catalog vocabulary, dialect registry, index-file protocol and the semantic find contract",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "cordis-plugin",
    "database",
    "sql",
    "sqlite",
    "mysql",
    "postgresql",
    "mongodb",
    "redis",
    "schema",
    "ai-agent",
    "llm-tools"
  ],
  "license": "MIT",
  "author": "CC ZHAO",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CC19990113/dsh-plugin-dbgraph.git",
    "directory": "packages/service"
  },
  "homepage": "https://github.com/CC19990113/dsh-plugin-dbgraph#readme",
  "bugs": "https://github.com/CC19990113/dsh-plugin-dbgraph/issues",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1",
    "@deepseek-ai/dsh-brand": ">=0.1.0-rc.6",
    "@deepseek-ai/dsh-invariants": ">=0.1.0-rc.6",
    "@deepseek-ai/dsh-llm": ">=0.1.0-rc.6"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-brand": "0.1.0-rc.6",
    "@deepseek-ai/dsh-invariants": "0.1.0-rc.6",
    "@deepseek-ai/dsh-llm": "0.1.0-rc.6"
  }
}
