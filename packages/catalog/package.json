{
  "name": "dsh-plugin-dbgraph-catalog",
  "version": "0.1.0",
  "description": "Database dialect catalog extractors for dsh-plugin-dbgraph: MySQL, PostgreSQL, SQLite and (later) MongoDB and Redis, each answering one normalized catalog snapshot",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "cordis-plugin",
    "database",
    "sql",
    "sqlite",
    "mysql",
    "postgresql",
    "mongodb",
    "redis",
    "schema",
    "ai-agent",
    "llm-tools"
  ],
  "license": "MIT",
  "author": "CC ZHAO",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CC19990113/dsh-plugin-dbgraph.git",
    "directory": "packages/catalog"
  },
  "homepage": "https://github.com/CC19990113/dsh-plugin-dbgraph#readme",
  "bugs": "https://github.com/CC19990113/dsh-plugin-dbgraph/issues",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1",
    "@deepseek-ai/dsh-invariants": ">=0.1.0-rc.6",
    "@deepseek-ai/dsh-llm": ">=0.1.0-rc.6"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-invariants": "0.1.0-rc.6",
    "@deepseek-ai/dsh-llm": "0.1.0-rc.6",
    "dsh-plugin-dbgraph-service": "workspace:^",
    "mysql2": "^3.11.0",
    "pg": "^8.13.0"
  },
  "dependencies": {
    "dsh-plugin-dbgraph-service": "workspace:^"
  },
  "optionalDependencies": {
    "mysql2": "^3.11.0",
    "pg": "^8.13.0"
  }
}
